# --- Required ---
# MUST be a cryptographically random string of at least 32 characters.
# The server refuses to boot without it (or with a placeholder value).
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Server ---
PORT=3001
# Locked CORS origin (browser frontend)
CORS_ORIGIN=http://localhost:3000

# --- Database (embedded SQLite, no external daemon) ---
DATABASE_PATH=./data/app.db

# --- Auth / tokens ---
# Access JWT lifetime (seconds, HS256)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime (days); refresh tokens are opaque, stored hashed, rotated
REFRESH_TOKEN_TTL_DAYS=30

# --- Limits / abuse defense ---
MAX_MESSAGE_LENGTH=4000
MAX_GROUP_SIZE=50
JSON_BODY_LIMIT=64kb
SOCKET_MAX_HTTP_BUFFER_SIZE=65536
# Global API rate limit per IP (requests per minute)
RATE_LIMIT_IP_PER_MIN=300
# Authenticated API rate limit per user (requests per minute)
RATE_LIMIT_USER_PER_MIN=600
# Strict /auth limiter: per action key (IP[+username]) per minute
AUTH_RATE_LIMIT_PER_MIN=5
# Message flood throttle per user
MESSAGE_RATE_LIMIT_COUNT=10
MESSAGE_RATE_LIMIT_WINDOW_MS=5000
# Typing event throttle per user per conversation
TYPING_MIN_INTERVAL_MS=1000
TYPING_RATE_LIMIT_PER_MIN=20